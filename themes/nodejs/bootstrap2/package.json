{
  "name": "@betterportal/theme-bootstrap2",
  "version": "10.6.5",
  "private": true,
  "description": "BetterPortal v10 Bootstrap2 theme plugin for Node.js",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "bsb-plugin-cli build",
    "clean": "bsb-plugin-cli clean",
    "start": "bsb-plugin-cli start",
    "dev": "bsb-plugin-cli dev",
    "test": "node --import tsx --test tests/routeVisibility.test.ts && bsb-plugin-cli test",
    "bp:gen": "bp run gen",
    "bp:types": "bp run types",
    "bp:contract": "bp run contract",
    "publish:bp": "bp publish",
    "prepublishOnly": "npm run build",
    "publish:client": "bsb-client-cli publish"
  },
  "keywords": [
    "betterportal",
    "theme",
    "bootstrap",
    "htmx"
  ],
  "author": "BetterCorp",
  "license": "(AGPL-3.0-only OR Commercial)",
  "type": "module",
  "devDependencies": {
    "@bsb/tests": "^9.6.86",
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@betterportal/framework": "10.6.5",
    "@betterportal/plugin-bsb": "10.6.5",
    "@betterportal/theme-runtime": "10.6.5",
    "@bsb/base": "^9.6.86",
    "anyvali": "^1.1.0",
    "bootstrap": "^5.3.8",
    "jsx-htmx": "4.0.0"
  },
  "files": [
    "lib/**/*",
    "bp-resources/**/*",
    "README.md",
    "bsb-plugin.json",
    "betterportal-logo.png"
  ],
  "bsb": {
    "orgId": "betterportal",
    "hooks": {
      "afterSchemas": [
        "bp:gen",
        "bp:types"
      ],
      "afterBuild": [
        "bp:contract"
      ]
    }
  },
  "betterportal": {
    "definitions": [
      "src/plugins/service-betterportal-theme-bootstrap2/index.ts"
    ],
    "shells": [
      "src/plugins/service-betterportal-theme-bootstrap2/shell"
    ]
  },
  "homepage": "https://github.com/BetterCorp/BetterPortal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterCorp/BetterPortal.git",
    "directory": "themes/nodejs/bootstrap2"
  },
  "bugs": {
    "url": "https://github.com/BetterCorp/BetterPortal/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
