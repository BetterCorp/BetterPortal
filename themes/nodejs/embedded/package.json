{
  "name": "@betterportal/theme-embedded",
  "version": "11.0.6",
  "description": "BetterPortal v10 embedded theme plugin for Node.js",
  "main": "lib/index.js",
  "types": "src/index.ts",
  "scripts": {
    "build": "bsb-plugin-cli build",
    "clean": "bsb-plugin-cli clean",
    "start": "bsb-plugin-cli start",
    "dev": "bsb-plugin-cli dev",
    "test": "node --import tsx --test tests/runtime.test.ts && bsb-plugin-cli test",
    "bp:gen": "bp run gen",
    "bp:types": "bp run types",
    "bp:contract": "bp run contract",
    "publish:bp": "bp publish",
    "prepublishOnly": "npm run build",
    "publish:client": "bsb-client-cli publish",
    "prebuild": "bp run check-routes"
  },
  "keywords": [
    "betterportal",
    "theme",
    "embedded"
  ],
  "author": "BetterCorp",
  "license": "(AGPL-3.0-only OR Commercial)",
  "type": "module",
  "devDependencies": {
    "@bsb/tests": "^9.7.5",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@betterportal/framework": "11.0.6",
    "@betterportal/plugin-bsb": "11.0.6",
    "@betterportal/theme-runtime": "11.0.6",
    "@bsb/base": "^9.7.5",
    "anyvali": "^1.1.7",
    "jsx-htmx": "4.0.100"
  },
  "files": [
    "lib/**/*",
    "bp-resources/**/*",
    "README.md",
    "bsb-plugin.json",
    "betterportal-logo.png"
  ],
  "bsb": {
    "orgId": "betterportal",
    "hooks": {
      "afterSchemas": [
        "bp:gen",
        "bp:types"
      ],
      "afterBuild": [
        "bp:contract"
      ]
    }
  },
  "betterportal": {
    "definitions": [
      "src/plugins/service-betterportal-theme-embedded/index.ts"
    ],
    "shells": [
      "src/plugins/service-betterportal-theme-embedded/shell"
    ]
  },
  "homepage": "https://github.com/BetterCorp/BetterPortal#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterCorp/BetterPortal.git",
    "directory": "themes/nodejs/embedded"
  },
  "bugs": {
    "url": "https://github.com/BetterCorp/BetterPortal/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
