{
  "name": "betterportal",
  "version": "11.0.3",
  "description": "BetterPortal v10 workspace",
  "private": true,
  "scripts": {
    "build": "node scripts/run-workspace-scripts.mjs . build",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "test": "node --test tests/lint.test.mjs tests/security.test.mjs tests/automations.test.mjs tests/workspaceRunner.test.mjs && node scripts/run-workspace-scripts.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "(AGPL-3.0-only OR Commercial)",
  "workspaces": [
    "framework/nodejs",
    "plugins/nodejs/betterportal-bsb",
    "services/nodejs/auth-default",
    "services/nodejs/auth-authress-io",
    "services/nodejs/auth-workos",
    "themes/nodejs/runtime",
    "themes/nodejs/bootstrap1",
    "themes/nodejs/bootstrap2",
    "themes/nodejs/embedded",
    "services/nodejs/admin/config-manager",
    "services/nodejs/docs-site",
    "services/nodejs/registry",
    "services/nodejs/examples/hello-view",
    "automations/n8n",
    "automations/node-red",
    "automations/zapier"
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "eslint": "^10.10.0",
    "eslint-plugin-tsdoc": "^0.5.2",
    "globals": "^17.12.0",
    "typescript-eslint": "^8.72.0"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.3.2"
    }
  }
}
