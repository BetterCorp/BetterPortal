{
  "name": "@betterportal/framework",
  "version": "10.6.3",
  "description": "BetterPortal v10 core library for Node.js",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "bin": {
    "bp": "lib/cli/bp.js",
    "bp-codegen": "lib/codegen/cli.js",
    "bp-init": "lib/codegen/init.js"
  },
  "scripts": {
