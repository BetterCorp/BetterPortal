{
  "anyvaliVersion": "1.0",
  "schemaVersion": "1.1",
  "root": {
    "kind": "object",
    "properties": {
      "id": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "kind": {
        "kind": "enum",
        "values": [
          "page",
          "api"
        ],
        "default": "page"
      },
      "path": {
        "kind": "string",
        "minLength": 1
      },
      "serviceId": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "viewId": {
        "kind": "string",
        "minLength": 1
      },
      "servicePathVariant": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "fixedParams": {
        "kind": "optional",
        "inner": {
          "kind": "record",
          "valueSchema": {
            "kind": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "resolvedAuth": {
        "kind": "optional",
        "inner": {
          "kind": "array",
          "items": {
            "kind": "object",
            "properties": {
              "operationId": {
                "kind": "string",
                "minLength": 1
              },
              "method": {
                "kind": "enum",
                "values": [
                  "GET",
                  "POST",
                  "PUT",
                  "PATCH",
                  "DELETE",
                  "OPTIONS"
                ]
              },
              "auth": {
                "kind": "object",
                "properties": {
                  "required": {
                    "kind": "bool",
                    "default": false
                  },
                  "elevation": {
                    "kind": "optional",
                    "inner": {
                      "kind": "object",
                      "properties": {
                        "minimum": {
                          "kind": "enum",
                          "values": [
                            "confirm",
                            "mfa"
                          ]
                        },
                        "maxAgeSeconds": {
                          "kind": "optional",
                          "inner": {
                            "kind": "int",
                            "min": 1
                          }
                        }
                      },
                      "required": [
                        "minimum"
                      ],
                      "unknownKeys": "strip"
                    }
                  },
                  "callers": {
                    "kind": "array",
                    "items": {
                      "kind": "enum",
                      "values": [
                        "user",
                        "service",
                        "delegated"
                      ]
                    },
                    "minItems": 1,
                    "default": [
                      "user"
                    ]
                  },
                  "permissions": {
                    "kind": "array",
                    "items": {
                      "kind": "object",
                      "properties": {
                        "serviceId": {
                          "kind": "string",
                          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?){2,}$"
                        },
                        "viewId": {
                          "kind": "string",
                          "minLength": 1
                        },
                        "permissions": {
                          "kind": "array",
                          "items": {
                            "kind": "enum",
                            "values": [
                              "read",
                              "create",
                              "update",
                              "delete"
                            ]
                          },
                          "minItems": 1
                        }
                      },
                      "required": [
                        "serviceId",
                        "viewId",
                        "permissions"
                      ],
                      "unknownKeys": "strip"
                    },
                    "default": []
                  }
                },
                "required": [
                  "required",
                  "callers",
                  "permissions"
                ],
                "unknownKeys": "strip"
              }
            },
            "required": [
              "operationId",
              "method",
              "auth"
            ],
            "unknownKeys": "strip"
          }
        }
      },
      "authRequired": {
        "kind": "optional",
        "inner": {
          "kind": "bool"
        }
      },
      "menuPermissions": {
        "kind": "optional",
        "inner": {
          "kind": "array",
          "items": {
            "kind": "object",
            "properties": {
              "serviceId": {
                "kind": "string",
                "minLength": 1
              },
              "viewId": {
                "kind": "string",
                "minLength": 1
              },
              "permissions": {
                "kind": "array",
                "items": {
                  "kind": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "serviceId",
              "viewId",
              "permissions"
            ],
            "unknownKeys": "strip"
          }
        }
      },
      "sitemap": {
        "kind": "optional",
        "inner": {
          "kind": "object",
          "properties": {
            "kind": {
              "kind": "enum",
              "values": [
                "default",
                "exclude",
                "metadata",
                "provider"
              ]
            },
            "lastModified": {
              "kind": "optional",
              "inner": {
                "kind": "string",
                "format": "date-time"
              }
            },
            "changeFrequency": {
              "kind": "optional",
              "inner": {
                "kind": "enum",
                "values": [
                  "always",
                  "hourly",
                  "daily",
                  "weekly",
                  "monthly",
                  "yearly",
                  "never"
                ]
              }
            },
            "priority": {
              "kind": "optional",
              "inner": {
                "kind": "number",
                "min": 0,
                "max": 1
              }
            }
          },
          "required": [
            "kind"
          ],
          "unknownKeys": "strip"
        }
      },
      "robots": {
        "kind": "optional",
        "inner": {
          "kind": "array",
          "items": {
            "kind": "object",
            "properties": {
              "userAgent": {
                "kind": "string",
                "minLength": 1
              },
              "access": {
                "kind": "enum",
                "values": [
                  "allow",
                  "disallow"
                ]
              },
              "crawlDelaySeconds": {
                "kind": "optional",
                "inner": {
                  "kind": "int",
                  "min": 0,
                  "max": 86400
                }
              }
            },
            "required": [
              "userAgent",
              "access"
            ],
            "unknownKeys": "strip"
          }
        }
      },
      "targetPath": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "resolvedServicePath": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "resolvedMethods": {
        "kind": "optional",
        "inner": {
          "kind": "array",
          "items": {
            "kind": "enum",
            "values": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "OPTIONS"
            ]
          },
          "minItems": 1
        }
      },
      "query": {
        "kind": "optional",
        "inner": {
          "kind": "string"
        }
      },
      "title": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "icon": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "enabled": {
        "kind": "bool",
        "default": true
      },
      "enablement": {
        "kind": "optional",
        "inner": {
          "kind": "enum",
          "values": [
            "auto",
            "enabled",
            "disabled"
          ]
        }
      },
      "operations": {
        "kind": "array",
        "items": {
          "kind": "string",
          "minLength": 1
        },
        "minItems": 1
      },
      "menu": {
        "kind": "optional",
        "inner": {
          "kind": "bool"
        }
      },
      "chrome": {
        "kind": "optional",
        "inner": {
          "kind": "intersection",
          "allOf": [
            {
              "kind": "object",
              "properties": {
                "hideMenu": {
                  "kind": "optional",
                  "inner": {
                    "kind": "bool"
                  }
                },
                "hideHeader": {
                  "kind": "optional",
                  "inner": {
                    "kind": "bool"
                  }
                },
                "hideFooter": {
                  "kind": "optional",
                  "inner": {
                    "kind": "bool"
                  }
                },
                "fullScreen": {
                  "kind": "optional",
                  "inner": {
                    "kind": "bool"
                  }
                },
                "title": {
                  "kind": "optional",
                  "inner": {
                    "kind": "string"
                  }
                },
                "parents": {
                  "kind": "optional",
                  "inner": {
                    "kind": "array",
                    "items": {
                      "kind": "string",
                      "pattern": "^(?!//)"
                    }
                  }
                }
              },
              "required": [],
              "unknownKeys": "strip"
            },
            {
              "kind": "record",
              "valueSchema": {
                "kind": "union",
                "variants": [
                  {
                    "kind": "union",
                    "variants": [
                      {
                        "kind": "string"
                      },
                      {
                        "kind": "number"
                      },
                      {
                        "kind": "bool"
                      }
                    ]
                  },
                  {
                    "kind": "array",
                    "items": {
                      "kind": "string"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    },
    "required": [
      "id",
      "kind",
      "path",
      "serviceId",
      "viewId",
      "enabled",
      "operations"
    ],
    "unknownKeys": "strip"
  },
  "definitions": {},
  "extensions": {}
}
