{
  "anyvaliVersion": "1.0",
  "schemaVersion": "1.1",
  "root": {
    "kind": "object",
    "properties": {
      "ok": {
        "kind": "literal",
        "value": true
      },
      "pluginId": {
        "kind": "string",
        "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?){2,}$"
      },
      "cpUrl": {
        "kind": "string",
        "minLength": 1
      },
      "manifestVersion": {
        "kind": "string",
        "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
      },
      "apiKey": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1,
          "maxLength": 4096,
          "metadata": {
            "sensitive": true
          }
        }
      }
    },
    "required": [
      "ok",
      "pluginId",
      "cpUrl",
      "manifestVersion"
    ],
    "unknownKeys": "reject"
  },
  "definitions": {},
  "extensions": {}
}
