{
  "anyvaliVersion": "1.0",
  "schemaVersion": "1.1",
  "root": {
    "kind": "object",
    "properties": {
      "resolvedPolicy": {
        "kind": "optional",
        "inner": {
          "kind": "object",
          "properties": {
            "viewId": {
              "kind": "string",
              "minLength": 1
            },
            "operationId": {
              "kind": "string",
              "minLength": 1
            },
            "auth": {
              "kind": "object",
              "properties": {
                "required": {
                  "kind": "bool",
                  "default": false
                },
                "elevation": {
                  "kind": "optional",
                  "inner": {
                    "kind": "object",
                    "properties": {
                      "minimum": {
                        "kind": "enum",
                        "values": [
                          "confirm",
                          "mfa"
                        ]
                      },
                      "maxAgeSeconds": {
                        "kind": "optional",
                        "inner": {
                          "kind": "int",
                          "min": 1
                        }
                      }
                    },
                    "required": [
                      "minimum"
                    ],
                    "unknownKeys": "strip"
                  }
                },
                "callers": {
                  "kind": "array",
                  "items": {
                    "kind": "enum",
                    "values": [
                      "user",
                      "service",
                      "delegated"
                    ]
                  },
                  "minItems": 1,
                  "default": [
                    "user"
                  ]
                },
                "permissions": {
                  "kind": "array",
                  "items": {
                    "kind": "object",
                    "properties": {
                      "serviceId": {
                        "kind": "string",
                        "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?){2,}$"
                      },
                      "viewId": {
                        "kind": "string",
                        "minLength": 1
                      },
                      "permissions": {
                        "kind": "array",
                        "items": {
                          "kind": "enum",
                          "values": [
                            "read",
                            "create",
                            "update",
                            "delete"
                          ]
                        },
                        "minItems": 1
                      }
                    },
                    "required": [
                      "serviceId",
                      "viewId",
                      "permissions"
                    ],
                    "unknownKeys": "strip"
                  },
                  "default": []
                }
              },
              "required": [
                "required",
                "callers",
                "permissions"
              ],
              "unknownKeys": "strip"
            }
          },
          "required": [
            "viewId",
            "operationId",
            "auth"
          ],
          "unknownKeys": "strip"
        }
      },
      "serviceId": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "fragmentId": {
        "kind": "string",
        "minLength": 1
      },
      "targetPath": {
        "kind": "string",
        "minLength": 1
      },
      "enabled": {
        "kind": "bool",
        "default": true
      }
    },
    "required": [
      "serviceId",
      "fragmentId",
      "targetPath",
      "enabled"
    ],
    "unknownKeys": "strip"
  },
  "definitions": {},
  "extensions": {}
}
