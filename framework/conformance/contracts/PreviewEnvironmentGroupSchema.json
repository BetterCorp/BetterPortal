{
  "anyvaliVersion": "1.0",
  "schemaVersion": "1.1",
  "root": {
    "kind": "object",
    "properties": {
      "id": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "name": {
        "kind": "string",
        "minLength": 1
      },
      "sourceTenantId": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "sourceAppId": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "expiresInDays": {
        "kind": "nullable",
        "inner": {
          "kind": "int",
          "min": 1,
          "max": 3650
        },
        "default": 30
      },
      "elevatedRoleIds": {
        "kind": "array",
        "items": {
          "kind": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "maxItems": 100,
        "default": []
      },
      "apiKeyHash": {
        "kind": "string",
        "minLength": 1
      },
      "oidc": {
        "kind": "optional",
        "inner": {
          "kind": "object",
          "properties": {
            "issuer": {
              "kind": "string",
              "minLength": 1
            },
            "audience": {
              "kind": "string",
              "minLength": 1
            },
            "jwksUri": {
              "kind": "string",
              "format": "url"
            },
            "subjectPrefix": {
              "kind": "optional",
              "inner": {
                "kind": "string",
                "minLength": 1
              }
            },
            "requiredClaims": {
              "kind": "record",
              "valueSchema": {
                "kind": "string",
                "minLength": 1
              },
              "default": {}
            }
          },
          "required": [
            "issuer",
            "audience",
            "jwksUri",
            "requiredClaims"
          ],
          "unknownKeys": "strip"
        }
      },
      "services": {
        "kind": "array",
        "items": {
          "kind": "object",
          "properties": {
            "serviceId": {
              "kind": "string",
              "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?){2,}$"
            },
            "title": {
              "kind": "optional",
              "inner": {
                "kind": "string",
                "minLength": 1
              }
            },
            "configSchemas": {
              "kind": "optional",
              "inner": {
                "kind": "array",
                "items": {
                  "kind": "object",
                  "properties": {
                    "id": {
                      "kind": "string",
                      "minLength": 1
                    },
                    "title": {
                      "kind": "string",
                      "minLength": 1
                    },
                    "description": {
                      "kind": "string",
                      "minLength": 1
                    },
                    "scope": {
                      "kind": "enum",
                      "values": [
                        "tenant",
                        "app"
                      ]
                    },
                    "jsonSchema": {
                      "kind": "record",
                      "valueSchema": {
                        "kind": "ref",
                        "ref": "#/definitions/BetterPortalJsonValue"
                      }
                    },
                    "groups": {
                      "kind": "optional",
                      "inner": {
                        "kind": "array",
                        "items": {
                          "kind": "object",
                          "properties": {
                            "id": {
                              "kind": "string",
                              "minLength": 1
                            },
                            "title": {
                              "kind": "string",
                              "minLength": 1
                            },
                            "description": {
                              "kind": "optional",
                              "inner": {
                                "kind": "string"
                              }
                            },
                            "order": {
                              "kind": "optional",
                              "inner": {
                                "kind": "int"
                              }
                            },
                            "optional": {
                              "kind": "optional",
                              "inner": {
                                "kind": "bool"
                              }
                            }
                          },
                          "required": [
                            "id",
                            "title"
                          ],
                          "unknownKeys": "strip"
                        }
                      }
                    },
                    "fields": {
                      "kind": "array",
                      "items": {
                        "kind": "object",
                        "properties": {
                          "key": {
                            "kind": "string",
                            "minLength": 1
                          },
                          "title": {
                            "kind": "string",
                            "minLength": 1
                          },
                          "description": {
                            "kind": "string",
                            "minLength": 1
                          },
                          "scope": {
                            "kind": "enum",
                            "values": [
                              "tenant",
                              "app"
                            ]
                          },
                          "visibility": {
                            "kind": "enum",
                            "values": [
                              "public",
                              "protected",
                              "secret"
                            ]
                          },
                          "ownership": {
                            "kind": "enum",
                            "values": [
                              "bp",
                              "plugin",
                              "mixed"
                            ]
                          },
                          "sourceOfTruth": {
                            "kind": "enum",
                            "values": [
                              "bp",
                              "plugin",
                              "external"
                            ]
                          },
                          "groupId": {
                            "kind": "optional",
                            "inner": {
                              "kind": "string",
                              "minLength": 1
                            }
                          },
                          "order": {
                            "kind": "optional",
                            "inner": {
                              "kind": "int"
                            }
                          },
                          "defaultValue": {
                            "kind": "optional",
                            "inner": {
                              "kind": "ref",
                              "ref": "#/definitions/BetterPortalJsonValue"
                            }
                          },
                          "ui": {
                            "kind": "optional",
                            "inner": {
                              "kind": "object",
                              "properties": {
                                "control": {
                                  "kind": "optional",
                                  "inner": {
                                    "kind": "enum",
                                    "values": [
                                      "text",
                                      "textarea",
                                      "password",
                                      "number",
                                      "checkbox",
                                      "select",
                                      "multiselect",
                                      "color",
                                      "date",
                                      "time",
                                      "datetime-local",
                                      "url",
                                      "email"
                                    ]
                                  }
                                },
                                "placeholder": {
                                  "kind": "optional",
                                  "inner": {
                                    "kind": "string"
                                  }
                                },
                                "options": {
                                  "kind": "optional",
                                  "inner": {
                                    "kind": "array",
                                    "items": {
                                      "kind": "object",
                                      "properties": {
                                        "value": {
                                          "kind": "string",
                                          "minLength": 1
                                        },
                                        "label": {
                                          "kind": "string",
                                          "minLength": 1
                                        }
                                      },
                                      "required": [
                                        "value",
                                        "label"
                                      ],
                                      "unknownKeys": "strip"
                                    }
                                  }
                                },
                                "optionsSource": {
                                  "kind": "optional",
                                  "inner": {
                                    "kind": "enum",
                                    "values": [
                                      "app.routes"
                                    ]
                                  }
                                },
                                "min": {
                                  "kind": "optional",
                                  "inner": {
                                    "kind": "union",
                                    "variants": [
                                      {
                                        "kind": "number"
                                      },
                                      {
                                        "kind": "string"
                                      }
                                    ]
                                  }
                                },
                                "max": {
                                  "kind": "optional",
                                  "inner": {
                                    "kind": "union",
                                    "variants": [
                                      {
                                        "kind": "number"
                                      },
                                      {
                                        "kind": "string"
                                      }
                                    ]
                                  }
                                },
                                "step": {
                                  "kind": "optional",
                                  "inner": {
                                    "kind": "number"
                                  }
                                },
                                "rows": {
                                  "kind": "optional",
                                  "inner": {
                                    "kind": "int",
                                    "min": 1
                                  }
                                }
                              },
                              "required": [],
                              "unknownKeys": "strip"
                            }
                          },
                          "required": {
                            "kind": "bool",
                            "default": false
                          }
                        },
                        "required": [
                          "key",
                          "title",
                          "description",
                          "scope",
                          "visibility",
                          "ownership",
                          "sourceOfTruth",
                          "required"
                        ],
                        "unknownKeys": "strip"
                      },
                      "default": []
                    }
                  },
                  "required": [
                    "id",
                    "title",
                    "description",
                    "scope",
                    "jsonSchema",
                    "fields"
                  ],
                  "unknownKeys": "strip"
                }
              }
            },
            "config": {
              "kind": "object",
              "properties": {
                "tenant": {
                  "kind": "record",
                  "valueSchema": {
                    "kind": "ref",
                    "ref": "#/definitions/BetterPortalJsonValue"
                  },
                  "default": {}
                },
                "app": {
                  "kind": "record",
                  "valueSchema": {
                    "kind": "ref",
                    "ref": "#/definitions/BetterPortalJsonValue"
                  },
                  "default": {}
                }
              },
              "required": [
                "tenant",
                "app"
              ],
              "unknownKeys": "strip",
              "default": {
                "tenant": {},
                "app": {}
              }
            }
          },
          "required": [
            "serviceId",
            "config"
          ],
          "unknownKeys": "strip"
        },
        "default": []
      },
      "createdAt": {
        "kind": "string",
        "format": "date-time"
      },
      "updatedAt": {
        "kind": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "name",
      "sourceTenantId",
      "sourceAppId",
      "expiresInDays",
      "elevatedRoleIds",
      "apiKeyHash",
      "services",
      "createdAt",
      "updatedAt"
    ],
    "unknownKeys": "strip"
  },
  "definitions": {
    "BetterPortalJsonValue": {
      "kind": "union",
      "variants": [
        {
          "kind": "null"
        },
        {
          "kind": "bool"
        },
        {
          "kind": "string"
        },
        {
          "kind": "number"
        },
        {
          "kind": "array",
          "items": {
            "kind": "ref",
            "ref": "#/definitions/BetterPortalJsonValue"
          }
        },
        {
          "kind": "record",
          "valueSchema": {
            "kind": "ref",
            "ref": "#/definitions/BetterPortalJsonValue"
          }
        }
      ]
    }
  },
  "extensions": {}
}
