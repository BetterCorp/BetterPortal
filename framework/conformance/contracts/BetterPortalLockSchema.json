{
  "anyvaliVersion": "1.0",
  "schemaVersion": "1.1",
  "root": {
    "kind": "object",
    "properties": {
      "dependencies": {
        "kind": "record",
        "valueSchema": {
          "kind": "object",
          "properties": {
            "registryRef": {
              "kind": "string",
              "pattern": "^[a-z0-9][a-z0-9-]*/[a-z0-9][a-z0-9-]*$"
            },
            "pluginId": {
              "kind": "string",
              "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?){2,}$"
            },
            "version": {
              "kind": "string",
              "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
            },
            "digest": {
              "kind": "string",
              "pattern": "^sha256:[0-9a-f]{64}$"
            },
            "digestFormat": {
              "kind": "optional",
              "inner": {
                "kind": "literal",
                "value": "json-bytes"
              }
            }
          },
          "required": [
            "registryRef",
            "pluginId",
            "version",
            "digest"
          ],
          "unknownKeys": "reject"
        },
        "default": {}
      }
    },
    "required": [
      "dependencies"
    ],
    "unknownKeys": "reject"
  },
  "definitions": {},
  "extensions": {}
}
