              "kind": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        ]
      },
      "sub": {
        "kind": "string",
        "minLength": 1
      },
      "exp": {
        "kind": "int",
        "min": 1
      },
      "iat": {
        "kind": "int",
        "min": 0
      },
      "nbf": {
        "kind": "optional",
        "inner": {
          "kind": "int",
          "min": 0
        }
      },
      "jti": {
        "kind": "string",
        "minLength": 1
      },
      "realm": {
        "kind": "enum",
        "values": [
          "runtime",
          "control-plane"
        ]
      },
      "tenantId": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "appId": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "roles": {
        "kind": "array",
        "items": {
          "kind": "string",
          "minLength": 1
        },
        "default": []
      },
      "tokenType": {
        "kind": "enum",
        "values": [
          "access",
          "refresh",
          "cp-envelope",
          "setup",
          "install"
        ]
      },
      "authProvider": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "refreshContext": {
        "kind": "optional",
        "inner": {
          "kind": "record",
          "valueSchema": {
            "kind": "ref",
            "ref": "#/definitions/BetterPortalJsonValue"
          }
        }
      },
      "elevation": {
        "kind": "optional",
        "inner": {
          "kind": "object",
          "properties": {
            "assurance": {
              "kind": "enum",
              "values": [
                "confirmed",
                "mfa"
              ]
            },
            "verifiedAt": {
              "kind": "int",
              "min": 0
