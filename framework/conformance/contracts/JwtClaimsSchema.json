{
  "anyvaliVersion": "1.0",
  "schemaVersion": "1.1",
  "root": {
    "kind": "object",
    "properties": {
      "iss": {
        "kind": "string",
        "minLength": 1
      },
      "aud": {
        "kind": "union",
        "variants": [
          {
            "kind": "string",
            "minLength": 1
          },
          {
            "kind": "array",
