      "name": {
        "kind": "optional",
        "inner": {
          "kind": "string"
        }
      },
      "email": {
        "kind": "optional",
        "inner": {
          "kind": "string"
        }
      },
      "picture": {
        "kind": "optional",
        "inner": {
          "kind": "string"
