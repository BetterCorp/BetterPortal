            "assurance",
            "verifiedAt",
            "expiresAt"
          ],
          "unknownKeys": "strip"
        }
      },
      "sessionId": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "sessionVersion": {
        "kind": "optional",
        "inner": {
          "kind": "int",
          "min": 0
        }
      },
      "providerSubject": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "provider": {
        "kind": "optional",
        "inner": {
          "kind": "object",
          "properties": {
            "username": {
              "kind": "optional",
              "inner": {
                "kind": "string"
              }
            },
            "profileUrl": {
              "kind": "optional",
              "inner": {
                "kind": "string"
              }
            },
            "accountId": {
              "kind": "optional",
              "inner": {
                "kind": "union",
                "variants": [
                  {
                    "kind": "string"
                  },
                  {
                    "kind": "number"
                  }
                ]
              }
            },
            "nodeId": {
              "kind": "optional",
              "inner": {
                "kind": "string"
              }
            },
            "scope": {
              "kind": "optional",
              "inner": {
                "kind": "string"
              }
            }
          },
          "required": [],
          "unknownKeys": "strip"
