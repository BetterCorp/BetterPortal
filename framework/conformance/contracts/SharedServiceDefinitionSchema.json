{
  "anyvaliVersion": "1.0",
  "schemaVersion": "1.1",
  "root": {
    "kind": "object",
    "properties": {
      "id": {
        "kind": "string",
        "minLength": 1
      },
      "serviceId": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?){2,}$"
        }
      },
      "title": {
        "kind": "string",
        "minLength": 1
      },
      "description": {
        "kind": "optional",
        "inner": {
          "kind": "string"
        }
      },
      "logoUrl": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "format": "url"
        }
      },
      "baseUrl": {
        "kind": "string",
        "format": "url"
      },
      "apiKeyHash": {
        "kind": "string",
        "default": ""
      },
      "publicKeyPem": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "keyId": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "authProvider": {
        "kind": "optional",
        "inner": {
          "kind": "object",
          "properties": {
            "issuer": {
              "kind": "string",
              "minLength": 1
            },
            "audience": {
              "kind": "string",
              "minLength": 1
            },
            "jwksUri": {
              "kind": "string",
              "minLength": 1
            },
            "publicKeys": {
              "kind": "optional",
              "inner": {
                "kind": "object",
                "properties": {
                  "keys": {
                    "kind": "array",
                    "items": {
                      "kind": "object",
                      "properties": {
                        "kty": {
                          "kind": "literal",
                          "value": "RSA"
                        },
                        "use": {
                          "kind": "literal",
                          "value": "sig"
                        },
                        "alg": {
                          "kind": "literal",
                          "value": "RS256"
                        },
                        "kid": {
                          "kind": "string",
                          "minLength": 1
                        },
                        "n": {
                          "kind": "string",
                          "minLength": 1
                        },
                        "e": {
                          "kind": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kty",
                        "use",
                        "alg",
                        "kid",
                        "n",
                        "e"
                      ],
                      "unknownKeys": "strip"
                    }
                  }
                },
                "required": [
                  "keys"
                ],
                "unknownKeys": "strip"
              }
            }
          },
          "required": [
            "issuer",
            "audience",
            "jwksUri"
          ],
          "unknownKeys": "strip"
        }
      },
      "supportedDeploymentModes": {
        "kind": "array",
        "items": {
          "kind": "enum",
          "values": [
            "bp-hosted",
            "customer-hosted",
            "third-party-saas",
            "self-hosted",
            "saas-managed"
          ]
        },
        "default": []
      },
      "owner": {
        "kind": "enum",
        "values": [
          "bp",
          "3p"
        ],
        "default": "bp"
      },
      "upgradeUrlTemplate": {
        "kind": "optional",
        "inner": {
          "kind": "string"
        }
      },
      "category": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "tags": {
        "kind": "array",
        "items": {
          "kind": "string",
          "minLength": 1
        },
        "default": []
      },
      "pricingHint": {
        "kind": "optional",
        "inner": {
          "kind": "enum",
          "values": [
            "free",
            "freemium",
            "paid"
          ]
        }
      },
      "publishedAt": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "format": "date-time"
        }
      },
      "enabled": {
        "kind": "bool",
        "default": true
      }
    },
    "required": [
      "id",
      "title",
      "baseUrl",
      "apiKeyHash",
      "supportedDeploymentModes",
      "owner",
      "tags",
      "enabled"
    ],
    "unknownKeys": "strip"
  },
  "definitions": {},
  "extensions": {}
}
