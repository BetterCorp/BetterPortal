{
  "anyvaliVersion": "1.0",
  "schemaVersion": "1.1",
  "root": {
    "kind": "object",
    "properties": {
      "id": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "hostname": {
        "kind": "string",
        "format": "url"
      },
      "apiKeyHash": {
        "kind": "string",
        "default": ""
      },
      "publicKeyPem": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "keyId": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "serviceId": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z0-9](?:[a-z0-9-]*[a-z0-9])?){2,}$"
        }
      },
      "authProvider": {
        "kind": "optional",
        "inner": {
          "kind": "object",
          "properties": {
            "issuer": {
              "kind": "string",
              "minLength": 1
            },
            "audience": {
              "kind": "string",
              "minLength": 1
            },
            "jwksUri": {
              "kind": "string",
              "minLength": 1
            },
            "publicKeys": {
              "kind": "optional",
              "inner": {
                "kind": "object",
                "properties": {
                  "keys": {
                    "kind": "array",
                    "items": {
                      "kind": "object",
                      "properties": {
                        "kty": {
                          "kind": "literal",
                          "value": "RSA"
                        },
                        "use": {
                          "kind": "literal",
                          "value": "sig"
                        },
                        "alg": {
                          "kind": "literal",
                          "value": "RS256"
                        },
                        "kid": {
                          "kind": "string",
                          "minLength": 1
                        },
                        "n": {
                          "kind": "string",
                          "minLength": 1
                        },
                        "e": {
                          "kind": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "kty",
                        "use",
                        "alg",
                        "kid",
                        "n",
                        "e"
                      ],
                      "unknownKeys": "strip"
                    }
                  }
                },
                "required": [
                  "keys"
                ],
                "unknownKeys": "strip"
              }
            }
          },
          "required": [
            "issuer",
            "audience",
            "jwksUri"
          ],
          "unknownKeys": "strip"
        }
      },
      "capabilities": {
        "kind": "array",
        "items": {
          "kind": "string",
          "minLength": 1
        },
        "default": []
      },
      "title": {
        "kind": "string",
        "minLength": 1
      },
      "description": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "category": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "createdAt": {
        "kind": "string",
        "format": "date-time"
      },
      "enabled": {
        "kind": "bool",
        "default": true
      }
    },
    "required": [
      "id",
      "hostname",
      "apiKeyHash",
      "capabilities",
      "title",
      "createdAt",
      "enabled"
    ],
    "unknownKeys": "strip"
  },
  "definitions": {},
  "extensions": {}
}
