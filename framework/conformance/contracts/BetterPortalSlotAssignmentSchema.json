{
  "anyvaliVersion": "1.0",
  "schemaVersion": "1.1",
  "root": {
    "kind": "object",
    "properties": {
      "slotId": {
        "kind": "string",
        "minLength": 1
      },
      "serviceId": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "viewId": {
        "kind": "string",
        "minLength": 1
      },
      "renderer": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "enabled": {
        "kind": "bool",
        "default": true
      }
    },
    "required": [
      "slotId",
      "serviceId",
      "viewId",
      "enabled"
    ],
    "unknownKeys": "strip"
  },
  "definitions": {},
  "extensions": {}
}
