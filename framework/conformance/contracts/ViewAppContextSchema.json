      },
      "tenantId": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "slug": {
        "kind": "string",
        "minLength": 1
      },
      "title": {
        "kind": "string",
        "minLength": 1
      },
      "defaultRoute": {
        "kind": "string",
        "minLength": 1,
        "default": "/"
      },
      "auth": {
        "kind": "optional",
        "inner": {
          "kind": "optional",
          "inner": {
            "kind": "object",
            "properties": {
              "serviceId": {
                "kind": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              "loginViewId": {
                "kind": "optional",
                "inner": {
                  "kind": "optional",
                  "inner": {
                    "kind": "string",
                    "minLength": 1
                  }
