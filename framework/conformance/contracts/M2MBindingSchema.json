{
  "anyvaliVersion": "1.0",
  "schemaVersion": "1.1",
  "root": {
    "kind": "object",
    "properties": {
      "id": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "tenantId": {
        "kind": "string",
        "minLength": 1
      },
      "appId": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "minLength": 1
        }
      },
      "sourceServiceId": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "requestId": {
        "kind": "string",
        "minLength": 1
      },
      "contractId": {
        "kind": "string",
        "minLength": 1
      },
      "targetServiceId": {
        "kind": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      },
      "targetViewId": {
        "kind": "string",
        "minLength": 1
      },
      "mode": {
        "kind": "enum",
        "values": [
          "service",
          "delegated"
        ],
        "default": "service"
      },
      "enabled": {
        "kind": "bool",
        "default": true
      },
      "createdAt": {
        "kind": "string",
        "format": "date-time"
      }
    },
    "required": [
      "id",
      "tenantId",
      "sourceServiceId",
      "requestId",
      "contractId",
      "targetServiceId",
      "targetViewId",
      "mode",
      "enabled",
      "createdAt"
    ],
    "unknownKeys": "strip"
  },
  "definitions": {},
  "extensions": {}
}
