{
  "anyvaliVersion": "1.0",
  "schemaVersion": "1.1",
  "root": {
    "kind": "object",
    "properties": {
      "bindingId": {
        "kind": "string",
        "minLength": 1
      },
      "serviceId": {
        "kind": "string",
        "minLength": 1
      },
      "tenantId": {
        "kind": "string",
        "minLength": 1
      },
      "appIds": {
        "kind": "array",
        "items": {
          "kind": "string",
          "minLength": 1
        },
        "default": []
      },
      "endpointBaseUrl": {
        "kind": "string",
        "format": "url"
      },
      "deploymentMode": {
        "kind": "enum",
        "values": [
          "bp-hosted",
          "customer-hosted",
          "third-party-saas",
          "self-hosted",
          "saas-managed"
        ]
      },
      "enabled": {
        "kind": "bool",
        "default": true
      },
      "importedManifestVersion": {
        "kind": "string",
        "minLength": 1
      },
      "lastSyncAtIso": {
        "kind": "optional",
        "inner": {
          "kind": "string",
          "format": "date-time"
        }
      },
      "trust": {
        "kind": "object",
        "properties": {
          "credentialId": {
            "kind": "string",
            "minLength": 1
          },
          "issuer": {
            "kind": "string",
            "minLength": 1
          },
          "audience": {
            "kind": "string",
            "minLength": 1
          },
          "scopes": {
            "kind": "array",
            "items": {
              "kind": "string",
              "minLength": 1
            },
            "default": []
          },
          "rotationVersion": {
            "kind": "string",
            "minLength": 1
          }
        },
        "required": [
          "credentialId",
          "issuer",
          "audience",
          "scopes",
          "rotationVersion"
        ],
        "unknownKeys": "strip"
      }
    },
    "required": [
      "bindingId",
      "serviceId",
      "tenantId",
      "appIds",
      "endpointBaseUrl",
      "deploymentMode",
      "enabled",
      "importedManifestVersion",
      "trust"
    ],
    "unknownKeys": "strip"
  },
  "definitions": {},
  "extensions": {}
}
