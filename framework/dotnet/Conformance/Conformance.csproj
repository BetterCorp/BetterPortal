<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Small sequential probes do not need per-core server GC heaps. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../BetterPortal/BetterPortal.csproj" /><ProjectReference Include="../BetterPortal.AspNetCore/BetterPortal.AspNetCore.csproj" /></ItemGroup>
</Project>
