{
  "name": "@betterportal/registry",
  "version": "11.0.0",
  "private": true,
  "description": "BetterPortal service-contract registry",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "bsb-plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "bsb-plugin-cli build",
    "clean": "bsb-plugin-cli clean",
    "start": "bsb-plugin-cli start",
    "dev": "bsb-plugin-cli dev",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build",
    "publish:client": "bsb-client-cli publish"
  },
  "bsb": {
    "orgId": "betterportal"
  },
  "dependencies": {
    "@betterportal/framework": "11.0.0",
    "@bsb/base": "^9.7.4",
    "anyvali": "^1.1.6"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterCorp/BetterPortal.git"
  },
  "license": "(AGPL-3.0-only OR Commercial)"
}
