{
  "name": "@betterportal/registry",
  "version": "10.0.1",
  "description": "BetterPortal service-contract registry",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "bsb-plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "bsb-plugin-cli build",
    "clean": "bsb-plugin-cli clean",
    "start": "bsb-plugin-cli start",
    "dev": "bsb-plugin-cli dev",
    "test": "tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run build",
    "publish:client": "bsb-client-cli publish"
  },
  "bsb": {
    "orgId": "betterportal"
  },
  "dependencies": {
    "@betterportal/framework": "10.0.1",
    "@bsb/base": "^9.6.76",
    "anyvali": "^1.0.7"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BetterCorp/BetterPortal.git"
  },
  "license": "(AGPL-3.0-only OR Commercial)"
}
